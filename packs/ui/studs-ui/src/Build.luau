local function decode(value: any): any
    if type(value) ~= "table" then return value end
    local kind = value[1]
    if kind == "Color3" then return Color3.fromRGB(value[2], value[3], value[4]) end
    if kind == "UDim2" then return UDim2.new(value[2], value[3], value[4], value[5]) end
    if kind == "Vector2" then return Vector2.new(value[2], value[3]) end
    if kind == "UDim" then return UDim.new(value[2], value[3]) end
    if kind == "Enum" then return Enum[value[2]][value[3]] end
    if kind == "ColorSequence" then
        local keys = {}
        for i = 2, #value, 4 do
            table.insert(keys, ColorSequenceKeypoint.new(value[i], Color3.fromRGB(value[i+1], value[i+2], value[i+3])))
        end
        return ColorSequence.new(keys)
    end
    error("Unknown Studs UI value type: " .. tostring(kind))
end

local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")
assert(not RunService:IsRunning(), "Install Studs UI in edit mode, not during Play.")
local existing = StarterGui:FindFirstChild("StudsUI")
if existing then
    assert(existing:IsA("ScreenGui") and existing:GetAttribute("StudsPackId") == "studs-ui",
        "StarterGui.StudsUI is not marked as this pack. Rename it before installing; it was NOT changed.")
end

local built, root = {}, nil
local ok, problem = pcall(function()
    for index, record in ipairs(SCENE) do
        local object = Instance.new(record[1])
        built[index] = object
        if index == 1 then root = object end
        object.Name = record[2]
        if object:IsA("GuiObject") then
            object.BorderSizePixel = 0
            object.BackgroundTransparency = 1
            object.Active = false
        end
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            object.Font = Enum.Font.GothamBlack
            object.TextColor3 = Color3.new(1, 1, 1)
            object.TextStrokeTransparency = 1
            object.TextWrapped = true
            object.TextScaled = false
            object.RichText = false
            object.Text = ""
        end
        for i = 1, #record[4], 2 do object[record[4][i]] = decode(record[4][i+1]) end
        for i = 1, #record[5], 2 do object:SetAttribute(record[5][i], record[5][i+1]) end
        if record[3] ~= 0 then object.Parent = built[record[3]] end
    end
    for name, value in pairs(CONFIG) do root:SetAttribute(name, value) end
    local controller = Instance.new("LocalScript")
    controller.Name = "Controller"
    controller.Source = CONTROLLER_SOURCE
    controller.Parent = root
    -- A useful edit-mode fit; the Controller handles live viewport resizes.
    local camera = workspace.CurrentCamera
    if camera and camera.ViewportSize.X > 0 and camera.ViewportSize.Y > 0 then
        local size = camera.ViewportSize
        local scale = math.min(size.X / 2000, size.Y / 1125)
        root.DesignCanvas.ResponsiveScale.Scale = scale
        root.DesignCanvas.Size = UDim2.fromOffset(size.X / scale, size.Y / scale)
    end
end)
if not ok then
    -- Transactional install: preserve the old GUI if construction or Source fails.
    for _, object in ipairs(built) do object:Destroy() end
    error("Studs UI installation failed; previous installation preserved: " .. tostring(problem))
end
if existing then existing:Destroy() end
root.Parent = StarterGui
print("Studs UI installed: editable HUD, 9 closed panels, and embedded Controller. DEMO ONLY.")
return root
